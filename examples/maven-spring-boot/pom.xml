<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>example</groupId>
    <artifactId>maven-spring-boot-example</artifactId>
    <version>1.0.0</version>
    <name>maven-spring-boot-example</name>
    <description>Example Spring Boot app that records and verifies an AOT cache from its tests</description>

    <properties>
        <java.version>25</java.version>
        <aot-cache-training.version>0.1.0</aot-cache-training.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <env>
                            <!-- The buildpack only looks for a pre-recorded aot-cache/application.aot
                                 when its AOT-cache mode is on. -->
                            <BP_JVM_AOTCACHE_ENABLED>true</BP_JVM_AOTCACHE_ENABLED>
                            <!-- Load the cache with the same JDK that recorded it (25). -->
                            <BP_JVM_VERSION>25</BP_JVM_VERSION>
                            <!-- spring-boot:build-image re-lays-out the application and moves a
                                 top-level aot-cache/ under BOOT-INF/classes/, so point the
                                 buildpack at the delivered location. -->
                            <BP_JVM_AOTCACHE_PATH>BOOT-INF/classes/aot-cache/application.aot</BP_JVM_AOTCACHE_PATH>
                        </env>
                    </image>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.vpelikh</groupId>
                <artifactId>aot-cache-training-maven-plugin</artifactId>
                <version>${aot-cache-training.version}</version>
                <executions>
                    <execution>
                        <id>aot-record</id>
                        <!-- The packaged application records the cache in its own JVM, so
                             the goal runs after the package phase. -->
                        <phase>verify</phase>
                        <goals>
                            <goal>record</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>aot-verify</id>
                        <goals>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
